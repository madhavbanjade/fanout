{
  "info": {
    "name": "Notifyr API",
    "description": "Fanout notification delivery platform. All auth is cookie-based (httpOnly accessToken cookie) — enable Postman's cookie jar / use a single request tab so cookies persist between calls in this collection. There is exactly one admin account (the first user ever registered); every other registered user is an employee who can message any other registered user except for company-wide types, which are admin-only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3338/api/v1", "description": "Direct single-instance dev server — check api/.env's PORT, it changes. Switch to http://localhost:8080/api/v1 when running the full docker-compose + nginx load-balanced setup." }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alex Johnson\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"testpass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"testpass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Sets the accessToken cookie. The response body's `user.role` is either \"ADMIN\" or \"EMPLOYEE\". There is exactly one fixed admin account, seeded directly in the DB (not via signup): admin@admin.com / Admin@123."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List registered users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "Any logged-in user can list the roster — it feeds the recipient picker on both /notify (employees) and /admin (the admin)."
          }
        },
        {
          "name": "Get my notification preferences",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me/preferences", "host": ["{{baseUrl}}"], "path": ["users", "me", "preferences"] }
          }
        },
        {
          "name": "Update my notification preferences",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"taskUpdates\": false\n}" },
            "url": { "raw": "{{baseUrl}}/users/me/preferences", "host": ["{{baseUrl}}"], "path": ["users", "me", "preferences"] },
            "description": "systemSecurity is always forced back to true server-side, even if included in the body."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Create (for self)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"demo\",\n  \"payload\": { \"message\": \"Your queued notification is being delivered.\" }\n}" },
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "Get One",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notifications/:notificationId", "host": ["{{baseUrl}}"], "path": ["notifications", ":notificationId"] }
          }
        },
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notifications/stats", "host": ["{{baseUrl}}"], "path": ["notifications", "stats"] },
            "description": "Today's sent/delivered/failed counts and average delivery latency, each with a % change vs yesterday."
          }
        },
        {
          "name": "Delivery Volume (7 days)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/volume?days=7",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "volume"],
              "query": [{ "key": "days", "value": "7" }]
            }
          }
        },
        {
          "name": "Recent Deliveries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notifications/recent?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "recent"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Send (to any user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUserId\": \"<another-user-id>\",\n  \"type\": \"task\",\n  \"payload\": { \"message\": \"Please review the Q4 numbers\", \"category\": \"assigned\" }\n}" },
            "url": { "raw": "{{baseUrl}}/notifications/send", "host": ["{{baseUrl}}"], "path": ["notifications", "send"] },
            "description": "Any registered user can send to any other registered user. `type` can be mention/task/leave/meeting/resignation. The company-wide types (announcement/system/warning/termination) are rejected with 403 unless the caller's role is ADMIN — even when targeted at a single person, e.g. a warning or termination letter."
          }
        },
        {
          "name": "Broadcast (admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"announcement\",\n  \"payload\": { \"title\": \"Office closed Friday\", \"message\": \"The office will be closed for the holiday.\" }\n}" },
            "url": { "raw": "{{baseUrl}}/notifications/broadcast", "host": ["{{baseUrl}}"], "path": ["notifications", "broadcast"] },
            "description": "Sends to every registered user at once. Requires the caller's role to be ADMIN — returns 403 for anyone else."
          }
        },
        {
          "name": "Test Dead Letter",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/notifications/test-dead-letter", "host": ["{{baseUrl}}"], "path": ["notifications", "test-dead-letter"] },
            "description": "Creates a notification for a test user the worker is hardcoded to fail delivering, exercising BullMQ retries -> DEAD_LETTER."
          }
        }
      ]
    }
  ]
}
